# .dockerignore (Corrected Version)

#----------------------------------------
# Dependencies and Logs
#----------------------------------------
# Ignore local node modules, as they will be installed inside the container
node_modules
# Ignore npm debug logs
npm-debug.log*
solar-project-archieturerual-diagram.png
README.md
project-demo-screenshots


#----------------------------------------
# VCS, Environment, and Cache
#----------------------------------------
# Ignore the entire Git repository history
.git
# Ignore local cache directories
.cache
# CRITICAL: Never include environment files with secrets in the image
.env



#----------------------------------------
# Documentation Files
#----------------------------------------
# Ignore all markdown files...
*.md
# ...but make an exception for README files...
!README*.md
# ...and then re-ignore a specific secret README.
README-secret.md


#----------------------------------------
# CI/CD, Infrastructure, and Tooling
#----------------------------------------
# Ignore GitHub Actions workflows
.github/
# Ignore Terraform infrastructure code
terraform
# Ignore Jenkins files
jenkins*


#----------------------------------------
# Testing, Coverage, and Security Reports
#----------------------------------------
.nyc_output
.talismanrc
coverage
test-results.xml
# Generic report folders/files
reports*
zap*
dependency*
trivy-image*